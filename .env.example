# Copy to .env for local dev. Every value below is optional; the defaults in
# syncpad/config.py give you a working single-process server with SQLite and an
# in-process hub, i.e. no Docker required.

SYNCPAD_ENV=dev

# Postgres in prod; SQLite locally. A bare postgresql:// URL is upgraded to
# postgresql+asyncpg:// automatically, and libpq-only parameters such as
# sslmode= are translated for asyncpg rather than forwarded into an error.
# SYNCPAD_DATABASE_URL=postgresql://syncpad:syncpad@localhost:5432/syncpad
#
# Supabase: take the SESSION pooler string (port 5432). Note the username form
# postgres.<project-ref>, and percent-encode the password. Port 6543 is the
# transaction pooler, which also works -- prepared-statement caching is
# disabled automatically -- but costs you the statement cache. See DEPLOY.md.
# SYNCPAD_DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
SYNCPAD_DATABASE_URL=sqlite+aiosqlite:///./syncpad.db

# Unset => single-process InMemoryHub. Set => Redis Pub/Sub fan-out across
# replicas, which is what makes the gateway horizontally scalable.
# SYNCPAD_REDIS_URL=redis://localhost:6379/0

SYNCPAD_JWT_SECRET=dev-insecure-change-me
SYNCPAD_SNAPSHOT_EVERY_OPS=200
SYNCPAD_RATE_OPS_PER_S=120
SYNCPAD_CORS_ORIGINS=["*"]
